{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "parley/character.schema.json",
  "title": "Character card",
  "type": "object",
  "required": [
    "id", "name", "born", "died", "roles", "era_tags",
    "core_beliefs", "temperament", "speech_style",
    "key_events", "default_knowledge_cutoff"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "short_bio": { "type": "string", "maxLength": 160 },
    "born": { "type": "integer" },
    "died": { "type": "integer" },
    "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "era_tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "core_beliefs": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "temperament": { "type": "string", "minLength": 20 },
    "speech_style": { "type": "string", "minLength": 20 },
    "verbal_tics": { "type": "array", "items": { "type": "string" } },
    "key_events": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "relationships": {
      "type": "object",
      "description": "Keyed by other character id.",
      "additionalProperties": { "type": "string" }
    },
    "positions": {
      "type": "object",
      "description": "Keyed by issue slug; surfaced when the scenario tags the same issue.",
      "additionalProperties": { "type": "string" }
    },
    "sample_lines": {
      "type": "array",
      "description": "Few-shot voice anchors. Every entry MUST be a real, sourced utterance.",
      "items": {
        "type": "object",
        "required": ["text", "source"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 4 },
          "source": { "type": "string", "minLength": 4 },
          "verified": {
            "type": "boolean",
            "description": "true once a human has checked it against the cited source."
          }
        }
      }
    },
    "voice_note": {
      "type": "string",
      "description": "Used when few or no direct quotations survive; tells the model how to construct the voice instead."
    },
    "sensitivities": { "type": "string" },
    "portrait": { "type": "string" },
    "portrait_credit": { "type": "string" },
    "default_knowledge_cutoff": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date. Negative leading year = BCE."
    },
    "restricted": {
      "type": "object",
      "description": "Content-policy gate. See POLICY.md.",
      "required": ["reason", "allowed_scenario_types"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "allowed_scenario_types": {
          "type": "array",
          "items": { "enum": ["historical", "hypothetical", "custom"] }
        }
      }
    },
    "needs_review": {
      "type": "boolean",
      "description": "Card is machine-drafted and has not had its human editing pass yet."
    }
  }
}
