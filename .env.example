# Copy to .env (gitignored) and edit. Every value here has a working default except the
# provider keys — the app runs end to end with no configuration at all on the mock provider.

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# mock     - no key, no network, placeholder dialogue. Proves the plumbing. Default.
# aistudio - Gemini Developer API. The free prompt-lab path; get a key at ai.google.dev.
# vertex   - Vertex AI with application-default credentials. GCP credits apply HERE, not
#            to AI Studio keys — use this in production.
PARLEY_PROVIDER=mock

# aistudio
GEMINI_API_KEY=

# vertex (also needs: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Verify these model ids against current Vertex/AI Studio availability before deploying —
# names move, and a wrong id fails at the first turn rather than at boot.
PARLEY_MODEL_CHARACTER=gemini-2.5-flash-lite
PARLEY_MODEL_UTILITY=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Cost guards — every one of these is a hard stop
# ---------------------------------------------------------------------------
PARLEY_MAX_TURNS=28
PARLEY_MAX_OUTPUT_TOKENS=350
PARLEY_RECENT_WINDOW=12
PARLEY_MAX_CAST=4
PARLEY_CUSTOM_SCENARIO_CHARS=600

# The kill switch. Set to 1 and every model call refuses before it costs anything.
PARLEY_DISABLED=0

# HARD SPEND CEILING. Every model and TTS call is priced from the provider's own usage
# metadata as it returns; once this is crossed, the next call raises 402 and stops.
# This is enforced in seconds. A GCP budget reacts to billing data hours later — run both.
# See docs/COST.md.
PARLEY_SPEND_CEILING_USD=20
PARLEY_SPEND_DAILY_USD=20

# USD per 1M tokens. Defaults are deliberately HIGH so the ceiling trips early rather than
# late. VERIFY THESE against current pricing before trusting the estimate.
PARLEY_PRICE_CHAR_IN=1.50
PARLEY_PRICE_CHAR_OUT=9.00
PARLEY_PRICE_UTIL_IN=0.40
PARLEY_PRICE_UTIL_OUT=3.00
PARLEY_PRICE_CACHED_IN=0.40
PARLEY_PRICE_TTS=16.00

# Vertex context caching. The persona block is byte-identical every turn, and in a
# multi-agent chat that block is most of the input bill. Defaults on for vertex only.
PARLEY_CONTEXT_CACHE=
PARLEY_CONTEXT_CACHE_TTL=900

# ---------------------------------------------------------------------------
# Storage, auth, quotas
# ---------------------------------------------------------------------------
PARLEY_STORE=memory          # memory | firestore
PARLEY_QUOTAS=0
PARLEY_QUOTA_ANON=3
PARLEY_QUOTA_SIGNED_IN=10
PARLEY_FIREBASE_AUTH=0
PARLEY_IP_SALT=change-me-in-production

PARLEY_MODERATION=1

# ---------------------------------------------------------------------------
# Speech (Google Cloud Text-to-Speech)
# ---------------------------------------------------------------------------
# Off by default: billed PER CHARACTER, and a 28-turn scene is a lot of characters.
# Needs the Cloud Text-to-Speech API enabled on the project and ADC credentials.
PARLEY_TTS=0
PARLEY_TTS_VOICE=en-GB-Neural2-B
PARLEY_TTS_RATE=0.96
PARLEY_TTS_MAX_CHARS=900
PARLEY_TTS_SESSION_BUDGET=12000
# Verify voice names for your project: GET /api/tts/voices
PARLEY_FAME_FLOOR=15

PARLEY_CORS_ORIGINS=*
PARLEY_LOG_LEVEL=info
PARLEY_ADMIN_TOKEN=
